# Paid submissions: form -> Lemon Squeezy checkout -> order_created webhook
# -> one GitHub commit (content/boilerplates/<slug>.md + public/img/<slug>.<ext>)
# -> DEPLOY_HOOK_URL redeploys the site.

# Lemon Squeezy API key (Settings > API)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Variant of the "Add to BoilerplateSearch" product (regular listing)
LEMONSQUEEZY_LISTING_VARIANT_ID=
# Variant for a featured listing; leave empty to hide the Featured plan
LEMONSQUEEZY_FEATURED_VARIANT_ID=
# Signing secret set on the Lemon Squeezy webhook (Settings > Webhooks),
# URL: https://boilerplatesearch.com/api/lemonsqueezy/webhook, event: order_created
LEMONSQUEEZY_WEBHOOK_SECRET=

# GitHub token with Contents read/write on GITHUB_REPO
GITHUB_TOKEN=
GITHUB_REPO=Kaperskyguru/boilerplatesearch
GITHUB_BRANCH=main

# Optional: URL POSTed after a listing is committed (e.g. Coolify deploy webhook).
# Leave empty if pushes to GITHUB_BRANCH already redeploy the site.
DEPLOY_HOOK_URL=

# Public site URL, used for the post-payment redirect
SITE_URL=https://boilerplatesearch.com

# Where uploaded images wait until payment. Use a persistent volume in Docker.
SUBMISSIONS_DIR=.data/submissions

# Proxies in front of Node that append to X-Forwarded-For (used for the form's
# per-IP rate limit). 1 for Coolify/Traefik, 2 if Cloudflare is also in front,
# 0 if Node is reached directly.
TRUSTED_PROXY_HOPS=1

# Cloudflare R2 for submitted images (optional; without these, images use
# SUBMISSIONS_DIR on the server's disk and are committed into the repo).
# Uses a folder inside an existing bucket, so the bucket can be shared:
#   <R2_FOLDER>/pending/   uploads awaiting payment
#   <R2_FOLDER>/listings/  permanent images
# Add a lifecycle rule on the <R2_FOLDER>/pending/ prefix: delete after 7 days.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Folder (prefix) inside the bucket for this site. Default: boilerplatesearch
R2_FOLDER=boilerplatesearch
# Public URL of the bucket (custom domain or r2.dev), no trailing slash
R2_PUBLIC_URL=
